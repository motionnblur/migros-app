# Local PostgreSQL settings. Copy this file to postgres.env and replace the
# password before starting services. The file is ignored by Git; never commit
# real values.
#
# Docker Compose uses these to configure the postgres service and to derive the
# backend container datasource. The exact-local Maven profile also imports this
# file directly from backend/ so the hybrid JDBC fallback can reuse the same
# database name and credentials.
POSTGRES_USER=migros
POSTGRES_PASSWORD=replace-with-a-local-password
POSTGRES_DB=migros
