# Local Spring Boot settings. Copy this file to spring.env and replace every
# replace-with-* value. The file is ignored by Git; never commit real values.
#
# It is used in two ways:
#   1. Docker Compose reads it for variable substitution
#      (docker compose --env-file configs/spring.env ...).
#   2. The exact-local profile imports it directly when Maven runs from backend/
#      (spring.config.import=optional:file:../configs/spring.env[.properties]).
#      A real process environment variable always overrides a value in this file.
#
# Host/hybrid processes reach Postgres on localhost. Inside Compose the backend
# derives its coordinates from the Postgres service (see compose.yaml), so the
# JDBC host below must stay localhost for the hybrid workflow.

# --- Host / hybrid database settings ---
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/migros
SPRING_DATASOURCE_USERNAME=replace-with-your-postgres-user
SPRING_DATASOURCE_PASSWORD=replace-with-your-postgres-password

# --- Application ---
APP_PUBLIC_BASE_URL=http://localhost:8080
APP_ALLOWED_ORIGINS=http://localhost:4200,http://localhost:5000
APP_ALLOWED_ORIGIN_PATTERNS=http://localhost:*,http://127.0.0.1:*
# Writable directory for uploaded product images.
APP_UPLOAD_DIR=UploadFolder

# --- Inbound internal support bridge ---
# Independent, randomly generated Base64 secrets, each decoding to at least 32
# bytes, and different from each other. There is no fallback. Generate with:
#   openssl rand -base64 32
#
# The placeholder values below are recognized and rejected by TokenService, so
# this template is intentionally non-runnable until real secrets are generated.
JWT_USER_SECRET=replace-with-a-random-base64-user-secret
JWT_ADMIN_SECRET=replace-with-a-different-random-base64-admin-secret

# Shared key for the inbound internal support bridge (/internal/support/**).
# The backend refuses to start when this is missing. Generate with:
#   openssl rand -base64 32
# This is distinct from the outbound SUPPORT_SERVICE_INTERNAL_KEY.
SUPPORT_INTERNAL_KEY=replace-with-a-random-value

# --- Outbound support-service integration (optional) ---
# When SUPPORT_SERVICE_BASE_URL is left empty or unset, outbound publishing is
# disabled. There is no fallback to localhost:3000 inside the backend container.
SUPPORT_SERVICE_BASE_URL=
SUPPORT_SERVICE_INTERNAL_KEY=replace-with-the-outbound-support-service-key

# --- Stripe ---
# ISO 4217 currency charged through Stripe. Product and order prices are stored
# as major-unit TRY amounts, so this defaults to `try`. Only change it if the
# customer-facing currency labels change too.
PAYMENT_CURRENCY=try
STRIPE_API_KEY=replace-with-your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=replace-with-your-stripe-webhook-secret

# --- Mail ---
APP_MAIL_PROVIDER=smtp
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=replace-with-mail-username
MAIL_PASSWORD=replace-with-mail-password
APP_MAIL_FROM=no-reply@example.com
