# Local Spring Boot settings used by Docker Compose.
# Copy this file to spring.env and replace every replace-with-* value.

SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/migros
SPRING_DATASOURCE_USERNAME=migros
SPRING_DATASOURCE_PASSWORD=replace-with-the-postgres-password

APP_PUBLIC_BASE_URL=http://localhost:8080
APP_ALLOWED_ORIGINS=http://localhost:4200,http://localhost:5000
APP_ALLOWED_ORIGIN_PATTERNS=http://localhost:*

APP_MAIL_PROVIDER=smtp
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=replace-with-mail-username
MAIL_PASSWORD=replace-with-mail-password
APP_MAIL_FROM=no-reply@example.com
