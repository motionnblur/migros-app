# Production environment contract for the split-origin deployment.
#
# Copy this file into the hosting provider's environment/secret store and replace
# every replace-with-* value. Never commit a real copy of this file: it is the
# template only. All public origins must be absolute HTTPS origins with a host
# and no path, query string, or fragment, because the backend rejects anything
# else at startup.
#
# SPRING_PROFILES_ACTIVE must stay exactly `prod`. The repository recognizes
# local development only when the active-profile set is exactly `{local}`.
# Adding `local` here (for example `prod,local`) makes the runtime non-local, so
# the local admin/admin convenience account is never created and a legacy
# default administrator would block startup; do not add it.
#
# This template intentionally contains placeholders that are rejected or
# unusable until real values are supplied.

# --- Runtime profile ---
SPRING_PROFILES_ACTIVE=prod

# --- Datasource (managed PostgreSQL) ---
SPRING_DATASOURCE_URL=jdbc:postgresql://replace-with-db-host:5432/replace-with-db-name
SPRING_DATASOURCE_USERNAME=replace-with-db-user
SPRING_DATASOURCE_PASSWORD=replace-with-db-password

# --- Public origins ---
# The Angular frontend owns the password-reset route; the backend owns the signup
# confirmation endpoint. Both must use HTTPS.
APP_FRONTEND_BASE_URL=https://shop.example
APP_BACKEND_BASE_URL=https://api.shop.example

# Comma-separated allowed origins for HTTP CORS and the WebSocket handshake.
# Patterns are optional and, when present, must also be HTTPS.
APP_ALLOWED_ORIGINS=https://shop.example
APP_ALLOWED_ORIGIN_PATTERNS=

# --- Cookie security (keep Secure/HttpOnly with the intended SameSite policy) ---
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAMESITE=None

# --- JWT signing secrets ---
# Two independent Base64 secrets, each decoding to at least 32 bytes and
# different from each other. There is no fallback: startup fails when either is
# missing, blank, invalid Base64, shorter than 32 bytes, or identical.
# Generate each separately with: openssl rand -base64 32
JWT_USER_SECRET=replace-with-a-random-base64-user-secret
JWT_ADMIN_SECRET=replace-with-a-different-random-base64-admin-secret

# --- Stripe payments ---
# Use the production secret key and the production webhook signing secret. Never
# reuse a Stripe CLI whsec_... value outside local webhook testing.
STRIPE_API_KEY=replace-with-your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=replace-with-your-stripe-webhook-secret
PAYMENT_CURRENCY=try

# --- Support integration ---
# SUPPORT_INTERNAL_KEY protects the inbound internal bridge; the
# SUPPORT_SERVICE_* pair configures the outbound support-service call. Generate
# the inbound key separately with: openssl rand -base64 32
#
# When SUPPORT_SERVICE_BASE_URL is set, every support chat message
# creation/edit/delete writes a durable outbox record in the same transaction as
# the message. A scheduled worker claims due records with a bounded lease,
# delivers them outside the transaction, and retries failures with exponential
# backoff. Delivery is AT LEAST ONCE and never terminal, so the support service
# must deduplicate on the `eventId` in the payload, which stays stable across
# every retry. Events for one customer are delivered in commit order.
#
# SUPPORT_OUTBOX_ALERT_AFTER_ATTEMPTS only raises the failure log to ERROR once
# a receiver has refused that many times; delivery keeps retrying. The outbound
# timeouts must stay below SUPPORT_OUTBOX_LEASE_SECONDS or startup fails,
# because a delivery that outlives its lease is delivered twice at once. The
# remaining optional SUPPORT_OUTBOX_* values tune the worker; the defaults are
# appropriate for most deployments.
SUPPORT_INTERNAL_KEY=replace-with-a-random-inbound-internal-key
SUPPORT_SERVICE_BASE_URL=https://support.example
SUPPORT_SERVICE_INTERNAL_KEY=replace-with-the-outbound-support-service-key
# SUPPORT_OUTBOX_LEASE_SECONDS=120
# SUPPORT_OUTBOX_ALERT_AFTER_ATTEMPTS=8
# SUPPORT_OUTBOX_BACKOFF_BASE_SECONDS=30
# SUPPORT_OUTBOX_BACKOFF_MAX_SECONDS=1800
# SUPPORT_OUTBOX_PAGE_SIZE=20
# SUPPORT_OUTBOX_RETENTION_DAYS=30
# SUPPORT_SERVICE_CONNECT_TIMEOUT_MS=2000
# SUPPORT_SERVICE_READ_TIMEOUT_MS=10000

# --- Mail (signup confirmation and password reset) ---
# Production defaults to the Resend provider. Set RESEND_API_KEY for it. The
# SMTP_* values are required only when APP_MAIL_PROVIDER=smtp.
APP_MAIL_PROVIDER=resend
RESEND_API_KEY=replace-with-your-resend-api-key
APP_MAIL_FROM=no-reply@shop.example
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=replace-with-mail-username
MAIL_PASSWORD=replace-with-mail-password

# --- Persistent upload storage ---
# Mount a persistent disk at this path, or complete the object-storage
# migration. An ephemeral filesystem loses uploaded product images on
# redeploy/restart.
APP_UPLOAD_DIR=/var/data/migros-uploads

# --- Reverse proxies (optional, security logging) ---
# Leave empty unless a reverse proxy you control sits in front of the backend.
# The value is a comma-separated list of plain addresses or CIDR blocks; only
# when the immediate peer matches is its X-Forwarded-For header used to record
# the client address in security logs. Empty means the container's remote
# address is logged verbatim, so a forged forwarding header can never spoof the
# address recorded next to a failed login.
#
# Proxies append to X-Forwarded-For (Nginx uses $proxy_add_x_forwarded_for), so
# the left-most entry is whatever the caller sent. The application walks the
# chain from the right and takes the first entry that is not itself one of the
# proxies listed here. List every hop between the client and this backend: a hop
# you omit is indistinguishable from the client and its value becomes the one
# that gets logged.
APP_TRUSTED_PROXIES=
